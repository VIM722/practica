{
  "name": "TecnoSoporte Java 17",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",
  "forwardPorts": [8080],
  "portsAttributes": { "8080": { "label": "TecnoSoporte", "onAutoForward": "openPreview" } },
  "postCreateCommand": "chmod +x mvnw && ./mvnw -B -ntp verify",
  "customizations": { "vscode": { "extensions": ["vscjava.vscode-java-pack", "vmware.vscode-boot-dev-pack"] } }
}
